# ============================================================
# 环境变量配置示例
# ============================================================
# 将此文件复制为 .env 并根据需要修改
# cp .env.example .env

# ---------- Flask ----------
# Secret Key：用于 session 加密签名
# 生成方式：python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-at-least-64-chars-long

# 调试模式：仅开发环境设为 true
FLASK_ENV=development

# ---------- Session 安全 ----------
# 启用 HTTPS 时设为 true
SESSION_COOKIE_SECURE=False

# ---------- 数据库 ----------
# 默认使用项目 data/ 目录下的 SQLite 文件
DB_PATH=data/users.db

# ---------- 速率限制 ----------
RATELIMIT_LOGIN=10 per minute
RATELIMIT_REGISTER=3 per hour

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_FILE=logs/security.log
